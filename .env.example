# Provider routing per task (ollama|gemini|openai|anthropic)
MODEL_RESEARCH=ollama
MODEL_ANALYSIS=ollama
MODEL_CHAT=ollama
MODEL_CODE=ollama
MODEL_ORCHESTRATOR=ollama

# Ollama runtime
OLLAMA_ENABLED=
OLLAMA_BASE_URL=

# Local model aliases
